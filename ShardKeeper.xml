<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Inset custom artwork beneath the standard WoW tracking-button border. -->
  <Button name="ShardKeeperMinimapButton" parent="Minimap" frameStrata="LOW" frameLevel="8" hidden="false">
    <Size x="31" y="31"/>
    <Anchors><Anchor point="CENTER"/></Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentIcon" file="Interface\AddOns\ShardKeeper\Textures\Minimap-active">
          <Size x="26" y="26"/>
          <Anchors><Anchor point="CENTER" x="1.5" y="0.5"/></Anchors>
          <TexCoords left="0" right="1" top="0" bottom="1"/>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <Texture name="$parentBorder" file="Interface\Minimap\MiniMap-TrackingBorder">
          <Size x="54" y="54"/>
          <Anchors><Anchor point="TOPLEFT"/></Anchors>
        </Texture>
      </Layer>
    </Layers>
    <HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD"/>
  </Button>
</Ui>
